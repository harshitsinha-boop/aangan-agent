# Copy to .env.local (never commit real values). Mirror these in Vercel project settings.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vaani ---
VAANI_API_KEY=
VAANI_AGENT_ID=
# Agent used for outbound escalation fallback calls to Nikhil
VAANI_ALERT_AGENT_ID=
# Secret Vaani sends/we require on tool calls (header) and webhook (path token)
VAANI_TOOL_SECRET=
VAANI_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Aangan Studio <onboarding@resend.dev>"
# Test phase: redirect ALL outgoing mail to one inbox (Resend test sender only delivers to your own account email)
EMAIL_TEST_REDIRECT=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs/hashes action tokens; 32+ random bytes, base64
ACTION_TOKEN_SECRET=
# Shared secret pg_cron sends to /api/cron/*
CRON_SECRET=
# Call classification + evals (Gemini Flash, per the project stack). Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- HubSpot (optional) ---
# Private app token. Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write (notes need crm.objects.contacts.write).
HUBSPOT_ACCESS_TOKEN=
